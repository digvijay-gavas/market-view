{
  "manifest_version": 3,
  "name": "Market Family Collector",
  "version": "1.4.0",
  "minimum_chrome_version": "120",
  "description": "Collect Groww holdings, P&L lots and BM weights from this signed-in Chrome profile for your paired local Market collector.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://groww.in/*",
    "https://smallcases.groww.in/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Market Family Collector"
  },
  "options_page": "popup.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "include_globs": [
        "http://127.0.0.1:5186/runner*"
      ],
      "js": [
        "local-runner.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://groww.in/stocks/user/holdings*"
      ],
      "js": [
        "holdings-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
