{
  "manifest_version": 3,
  "name": "Market Family Collector",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "Collect Groww holdings from this signed-in Chrome profile for your paired local Market collector.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://groww.in/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Market Family Collector"},
  "options_page": "popup.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
